{
    "framework": "lza",
    "version": "1.0.0",
    "entries": [
        {
            "pathGlob": "**.serviceControlPolicies[*]**",
            "controls": ["SCP-guardrail"],
            "rationale": "SCP definitions are LZA's primary preventive control surface — any diff here associates with the guardrail plane.",
            "added": "2026-07-05"
        },
        {
            "pathGlob": "**.centralSecurityServices.guardduty.enable",
            "controls": ["threat-detection"],
            "rationale": "GuardDuty enable toggle materially changes the threat-detection posture.",
            "added": "2026-07-05"
        },
        {
            "pathGlob": "**.centralSecurityServices.securityHub.enable",
            "controls": ["security-hub"],
            "rationale": "Security Hub enable toggle changes the finding-aggregation surface.",
            "added": "2026-07-05"
        },
        {
            "pathGlob": "**.centralSecurityServices.macie.enable",
            "controls": ["data-classification"],
            "rationale": "Macie enable toggle changes the S3 data-classification surface.",
            "added": "2026-07-05"
        },
        {
            "pathGlob": "**.centralSecurityServices.accessAnalyzer.enable",
            "controls": ["access-analysis"],
            "rationale": "Access Analyzer enable toggle changes the resource-access review surface.",
            "added": "2026-07-05"
        },
        {
            "pathGlob": "**.deploymentTargets.accounts[*]**",
            "controls": ["account-targeting"],
            "rationale": "Deployment target account list changes affect which accounts inherit the associated control.",
            "added": "2026-07-05"
        },
        {
            "pathGlob": "**.deploymentTargets.organizationalUnits[*]**",
            "controls": ["ou-targeting"],
            "rationale": "Deployment target OU list changes affect the OU tree scope of the associated control.",
            "added": "2026-07-05"
        },
        {
            "pathGlob": "**.excludedAccounts**",
            "controls": ["exception-scope"],
            "rationale": "Excluded-account list expands the exception surface for the enclosing control.",
            "added": "2026-07-05"
        },
        {
            "pathGlob": "**.excludedRegions**",
            "controls": ["exception-scope"],
            "rationale": "Excluded-region list expands the exception surface for the enclosing control.",
            "added": "2026-07-05"
        },
        {
            "pathGlob": "**.logging.cloudtrail**",
            "controls": ["audit-log"],
            "rationale": "CloudTrail configuration is LZA's primary audit-log surface.",
            "added": "2026-07-05"
        },
        {
            "pathGlob": "**.logging.sessionManager**",
            "controls": ["session-log"],
            "rationale": "Session Manager logging changes affect the operator-shell audit surface.",
            "added": "2026-07-05"
        },
        {
            "pathGlob": "**.homeRegion",
            "controls": ["region-scope"],
            "rationale": "Home region changes affect the primary control-plane region for the entire landing zone.",
            "added": "2026-07-05"
        }
    ]
}
