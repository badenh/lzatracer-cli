{
    "framework": "nist",
    "version": "1.0.0",
    "entries": [
        {
            "pathGlob": "**.iamPolicies**",
            "controls": ["AC-3"],
            "rationale": "IAM policy definitions associate with Access Enforcement (AC-3).",
            "added": "2026-07-05"
        },
        {
            "pathGlob": "**.iamRoles**",
            "controls": ["AC-3"],
            "rationale": "IAM role definitions associate with Access Enforcement (AC-3).",
            "added": "2026-07-05"
        },
        {
            "pathGlob": "**.iamGroups**",
            "controls": ["AC-2"],
            "rationale": "IAM group definitions associate with Account Management (AC-2).",
            "added": "2026-07-05"
        },
        {
            "pathGlob": "**.iamUsers**",
            "controls": ["AC-2"],
            "rationale": "IAM user definitions associate with Account Management (AC-2).",
            "added": "2026-07-05"
        },
        {
            "pathGlob": "**.nacls**",
            "controls": ["SC-7"],
            "rationale": "Network ACL definitions associate with Boundary Protection (SC-7).",
            "added": "2026-07-05"
        },
        {
            "pathGlob": "**.securityGroups**",
            "controls": ["SC-7"],
            "rationale": "Security Group definitions associate with Boundary Protection (SC-7).",
            "added": "2026-07-05"
        },
        {
            "pathGlob": "**.routeTables**",
            "controls": ["SC-7"],
            "rationale": "Route table definitions associate with Boundary Protection (SC-7).",
            "added": "2026-07-05"
        },
        {
            "pathGlob": "**.transitGateways**",
            "controls": ["SC-7"],
            "rationale": "Transit gateway definitions associate with Boundary Protection (SC-7).",
            "added": "2026-07-05"
        },
        {
            "pathGlob": "**.logging.cloudtrail**",
            "controls": ["AU-2", "AU-3"],
            "rationale": "CloudTrail configuration associates with Audit Events (AU-2) and Audit Record Content (AU-3).",
            "added": "2026-07-05"
        },
        {
            "pathGlob": "**.logging.sessionManager**",
            "controls": ["AU-2"],
            "rationale": "Session Manager logging associates with Audit Events (AU-2).",
            "added": "2026-07-05"
        },
        {
            "pathGlob": "**.centralSecurityServices.guardduty.enable",
            "controls": ["SI-4"],
            "rationale": "GuardDuty enable toggle associates with System Monitoring (SI-4).",
            "added": "2026-07-05"
        },
        {
            "pathGlob": "**.centralSecurityServices.securityHub.enable",
            "controls": ["CA-7"],
            "rationale": "Security Hub enable toggle associates with Continuous Monitoring (CA-7).",
            "added": "2026-07-05"
        },
        {
            "pathGlob": "**.centralSecurityServices.macie.enable",
            "controls": ["SI-7"],
            "rationale": "Macie enable toggle associates with Software Firmware and Information Integrity (SI-7) via S3-object classification.",
            "added": "2026-07-05"
        },
        {
            "pathGlob": "**.centralSecurityServices.accessAnalyzer.enable",
            "controls": ["AC-3"],
            "rationale": "Access Analyzer enable toggle associates with Access Enforcement (AC-3) via unintended-access review.",
            "added": "2026-07-05"
        },
        {
            "pathGlob": "**.kmsKeys**",
            "controls": ["SC-12", "SC-28"],
            "rationale": "KMS key definitions associate with Cryptographic Key Establishment and Management (SC-12) and Protection of Information at Rest (SC-28).",
            "added": "2026-07-05"
        }
    ]
}
