{
    "framework": "cis",
    "version": "1.0.0",
    "entries": [
        {
            "pathGlob": "**.iamPolicies**",
            "controls": ["CIS-1.16"],
            "rationale": "IAM policy definitions associate with CIS 1.16 (Ensure IAM policies are attached only to groups or roles).",
            "added": "2026-07-05"
        },
        {
            "pathGlob": "**.mandatoryAccountConfig.iam.userCreation**",
            "controls": ["CIS-1.4"],
            "rationale": "Root/administrative user creation policy associates with CIS 1.4 (Ensure no root user access key exists).",
            "added": "2026-07-05"
        },
        {
            "pathGlob": "**.centralSecurityServices.guardduty.enable",
            "controls": ["CIS-3.14"],
            "rationale": "GuardDuty enable toggle associates with CIS 3.14 (Ensure Amazon GuardDuty is enabled).",
            "added": "2026-07-05"
        },
        {
            "pathGlob": "**.logging.cloudtrail**",
            "controls": ["CIS-3.1", "CIS-3.2"],
            "rationale": "CloudTrail configuration associates with CIS 3.1 (Ensure CloudTrail is enabled in all regions) and CIS 3.2 (Ensure log file validation).",
            "added": "2026-07-05"
        },
        {
            "pathGlob": "**.logging.cloudtrail.enableKmsCmk",
            "controls": ["CIS-3.7"],
            "rationale": "CloudTrail KMS CMK toggle associates with CIS 3.7 (Ensure CloudTrail logs are encrypted at rest using KMS CMKs).",
            "added": "2026-07-05"
        },
        {
            "pathGlob": "**.nacls**",
            "controls": ["CIS-5.1"],
            "rationale": "Network ACL definitions associate with CIS 5.1 (Ensure no Network ACLs allow ingress from 0.0.0.0/0 to admin ports).",
            "added": "2026-07-05"
        },
        {
            "pathGlob": "**.securityGroups**",
            "controls": ["CIS-5.2", "CIS-5.3"],
            "rationale": "Security Group definitions associate with CIS 5.2 (SSH ingress) and CIS 5.3 (RDP ingress) rule policies.",
            "added": "2026-07-05"
        },
        {
            "pathGlob": "**.mandatoryAccountConfig.passwordPolicy**",
            "controls": ["CIS-1.5", "CIS-1.6", "CIS-1.7"],
            "rationale": "Password policy definitions associate with CIS 1.5-1.7 (password complexity, length, reuse).",
            "added": "2026-07-05"
        }
    ]
}
